# Copy to scripts/gcp/worker.env (gitignored) and fill from .env.local.
# This file is uploaded to the e2-micro VM — never commit real secrets.

# Database (worker prefers DIRECT_DATABASE_URL)
DIRECT_DATABASE_URL=
DATABASE_URL=
PG_POOL_MAX=2

ORCHESTRATOR=postgres
ORCHESTRATION_POLL_MS=800
ORCHESTRATION_LEASE_SECONDS=600
ORCHESTRATION_WORKER_MAX_CONCURRENCY=2
ORCHESTRATION_WORKER_ID=gcp-e2-micro-1

# Lane caps — keep tiny on 1 GB RAM
ORG_EMAIL_SEND_CONCURRENCY=1
ORG_EXTRACTION_CONCURRENCY=1
ORG_RESEARCH_CONCURRENCY=1
ORG_PROFILE_RESCUE_CONCURRENCY=1
ORG_EMAIL_RESCUE_CONCURRENCY=1
ORG_FINALIZE_CONCURRENCY=1
ORG_VERIFY_CONCURRENCY=1
ORG_MAILBOX_VERIFY_CONCURRENCY=1
ORG_DRAFT_RESEARCH_CONCURRENCY=1
ORG_DRAFT_WRITE_CONCURRENCY=1

# Providers the worker may call
RESEND_API_KEY=
ANTHROPIC_API_KEY=

# Mailbox / drafting modes should match production app
DRAFTING_MODE=live
EXTRACTION_MODE=live

# Absolute origin for HTML email signature image URLs (must be publicly reachable)
HELIOS_PUBLIC_URL=https://www.heliosgroup.tech

# Optional AgentMail if mailbox verify runs on this worker
# AGENT_MAIL_API=
# AGENTMAIL_INBOX_ID=
