    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
