# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ── Claude / Anthropic Console ──────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Admin API key (sk-ant-admin01-…) for Cost API reconciliation in Analytics Hub.
# Console → Settings → Admin API keys. Do not use the Messages API key.
ANTHROPIC_ADMIN_API_KEY=

# ── Supabase (Postgres) ─────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to the client/browser
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string
# Runtime prefers DIRECT (session :5432). Keep PG_POOL_MAX tiny so Next+worker
# stay under Supabase session pool_size≈15. Transaction (:6543) is optional —
# set OUTREACH_DB_USE_TRANSACTION_POOLER=1 only when that port is reachable.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Per-process node-pg pool size (Next and worker each open one). Keep tiny
# under Supabase session pool_size≈15 or you'll see EMAXCONNSESSION.
PG_POOL_MAX=2
# OUTREACH_DB_USE_TRANSACTION_POOLER=1

# ── Auth.js (Google sign-in) ─────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# App URL Auth.js uses for callbacks (local + production)
# AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Google Cloud setup (free):
# 1. Console → APIs & Services → OAuth consent screen
# 2. Create OAuth Client ID → Web application
# 3. Authorized redirect URIs:
#    http://localhost:3000/api/auth/callback/google
#    https://<your-production-host>/api/auth/callback/google
# 4. Paste Client ID / Secret above (+ Vercel env for prod)
# 5. Sign in with a @heliosgroup.ai Google account; personal Gmail must be rejected
# Full checklist: docs/google-oauth-setup.md

# Login allowlist — required in production (`*` is refused). Comma-separated, no quotes.
ALLOWED_EMAIL_DOMAINS=heliosgroup.ai,heliosmarketing.org

# ── Helios Dashboards (merged product) ───────────────────────────────────────
# AES-256-GCM key for per-user GitHub PATs at rest. Generate once and back up
# in 1Password — rotating without a re-encrypt migration permanently loses PATs.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optional bootstrap only (local smoke / one-time import). Production sync uses
# encrypted dashboards.github_tokens rows, not this env singleton.
# GITHUB_TOKEN=

# Legacy (unused for login after Auth.js cutover; safe to leave blank)
# SESSION_SECRET=

# Optional absolute path to psql if it is not on PATH
# PSQL_BIN=/opt/homebrew/opt/libpq/bin/psql

# ── Durable Postgres worker / extraction ─────────────────────────────────────
# Local: `npm run dev` starts Next.js and the worker together.
# Production: deploy `npm run worker` as a separate always-on service (Dockerfile.worker).
# Concurrency defaults are sized so hundreds of leads queue safely without blowing
# Supabase connection budgets. Raise carefully after watching pooler metrics.
ORCHESTRATOR=postgres
ORCHESTRATION_POLL_MS=400
ORCHESTRATION_LEASE_SECONDS=600
ORCHESTRATION_WORKER_MAX_CONCURRENCY=16
ORCHESTRATION_WORKER_REPLACE=1
# Laptop/dev workers claim whenever they are alive. The cloud VM should set
# ORCHESTRATION_FALLBACK_WORKER_ID=gcp-e2-micro-1 so it yields while the
# machine heartbeat is live, then takes over ~45s after the laptop goes away.
# Do not set a primary/fallback id on the laptop — that would make it yield.
# ORCHESTRATION_FALLBACK_WORKER_ID=gcp-e2-micro-1
# ORCHESTRATION_WORKER_ID=local-dev-1
ORG_EXTRACTION_CONCURRENCY=3
ORG_RESEARCH_CONCURRENCY=2
ORG_PROFILE_RESCUE_CONCURRENCY=2
ORG_EMAIL_RESCUE_CONCURRENCY=2
ORG_FINALIZE_CONCURRENCY=2
ORG_VERIFY_CONCURRENCY=2
ORG_SCRAPE_CONCURRENCY=2
ORG_SCRAPE_GLOBAL_CONCURRENCY=4
ORG_SCRAPE_PER_HOST_CONCURRENCY=2
# Server-only managed-browser /content-compatible endpoint. Normal HTTP fetch
# always runs first; this is used only for likely JS shells and blocked high-value pages.
BROWSER_RENDER_URL=
BROWSER_RENDER_API_KEY=
ORG_PRIMARY_SEARCH_USES=5
ORG_PROFILE_RESCUE_SEARCH_USES=1
ORG_EMAIL_RESCUE_SEARCH_USES=4
SEARXNG_URL=
# Default is deliberately offline. Set to `live` only after approving a real
# extraction run; automated tests always use stubs.
EXTRACTION_MODE=stub

# Drafting research/writer mode.
# - Unset in production → defaults to live
# - Unset locally / in tests → defaults to stub (no Claude / web_search)
# - Explicit DRAFTING_MODE=live|stub always wins
# DRAFTING_MODE=live
# Research: 2 total provider calls, including the forced final report.
# The first call handles search choreography; the second produces the packet.
# Set searches to 2 for faster drafts when quality holds.
DRAFT_RESEARCH_MAX_SEARCHES=2
DRAFT_RESEARCH_MAX_CALLS=2
DRAFT_RESEARCH_MAX_TOKENS=8192
DRAFT_ADVERSARIAL_MAX_SEARCHES=1
DRAFT_ADVERSARIAL_MAX_TURNS=4
DRAFT_WRITER_MAX_TOKENS=2000
# Prompt cache TTL for static Claude prefixes (5m or 1h). See docs/prompt-caching.md
DRAFTING_PROMPT_CACHE_TTL=1h
DRAFTING_DEFAULT_BATCH_BUDGET_USD=50.0000
ORG_DRAFT_RESEARCH_CONCURRENCY=8
ORG_DRAFT_WRITE_CONCURRENCY=8
# Effective lane limits are capped at floor(DRAFTING_ANTHROPIC_MAX_INFLIGHT / peak_calls).
# Cold-start ramp: stagger Go to Drafting pipeline starts (ms between each lead).
DRAFTING_ANTHROPIC_MAX_INFLIGHT=8
DRAFTING_CAMPAIGN_RAMP_MS=3000

# https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

AGENT_MAIL_API=
AGENTMAIL_TLS_INSECURE=false
# Verify-only throwaway inbox. Must stay abcdefg@agentmail.to — never an outreach address.
AGENTMAIL_INBOX_ID=abcdefg@agentmail.to
AGENTMAIL_VERIFY_WAIT_MS=30000
ORG_MAILBOX_VERIFY_CONCURRENCY=3
# Required for POST /api/webhooks/agentmail (Svix signature or x-agentmail-secret).
# Unsigned requests are rejected. Worker inbox poll still works without this.
AGENTMAIL_WEBHOOK_SECRET=
# Production URL AgentMail must call: https://www.heliosgroup.tech/api/webhooks/agentmail
# Worker also polls outreach inboxes on system.reconcile if a webhook is missed.

# ── GCP cloud-worker spend tracking (Analytics Hub) ───────────────────────────
# Shared secret for Pub/Sub → POST /api/webhooks/gcp-billing?token=…
GCP_BILLING_WEBHOOK_TOKEN=
# Optional: clear leftover fail-closed flag via POST /api/billing-guard { action: "clear" }
BILLING_GUARD_CLEAR_SECRET=
# Public HTTPS origin that receives budget push notifications (production)
# HELIOS_PUBLIC_URL=https://www.heliosgroup.tech

# ── Outbound email (Agent Mail) ───────────────────────────────────────────────
# Outreach sends from the seven @heliosgroup.email / .online inboxes.
# Mailbox verification stays on AGENTMAIL_INBOX_ID (abcdefg@agentmail.to only).
# Conversations UI: /hub/conversations
