# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ── Claude / Anthropic Console ──────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Supabase (Postgres) ─────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to the client/browser
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string
# Runtime prefers DIRECT (session :5432). Keep PG_POOL_MAX tiny so Next+worker
# stay under Supabase session pool_size≈15. Transaction (:6543) is optional —
# set OUTREACH_DB_USE_TRANSACTION_POOLER=1 only when that port is reachable.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Per-process node-pg pool size (Next and worker each open one). Keep small.
PG_POOL_MAX=4
# OUTREACH_DB_USE_TRANSACTION_POOLER=1

# ── Session (passwordless JWT) ───────────────────────────────────────────────
# Long random string — e.g. openssl rand -base64 32
SESSION_SECRET=

# Login allowlist: `*` (or unset) = any valid email; or comma-separated domains
# e.g. ALLOWED_EMAIL_DOMAINS=gmail.com,lucasfigueroa.com
ALLOWED_EMAIL_DOMAINS=*

# Optional absolute path to psql if it is not on PATH
# PSQL_BIN=/opt/homebrew/opt/libpq/bin/psql

# ── Durable Postgres worker / extraction ─────────────────────────────────────
# Local: `npm run dev` starts Next.js and the worker together.
# Production: deploy `npm run worker` as a separate always-on service (Dockerfile.worker).
# Concurrency defaults are sized so hundreds of leads queue safely without blowing
# Supabase connection budgets. Raise carefully after watching pooler metrics.
ORCHESTRATOR=postgres
ORCHESTRATION_POLL_MS=400
ORCHESTRATION_LEASE_SECONDS=600
ORCHESTRATION_WORKER_MAX_CONCURRENCY=16
ORCHESTRATION_WORKER_REPLACE=1
ORG_EXTRACTION_CONCURRENCY=3
ORG_RESEARCH_CONCURRENCY=2
ORG_PROFILE_RESCUE_CONCURRENCY=2
ORG_EMAIL_RESCUE_CONCURRENCY=2
ORG_FINALIZE_CONCURRENCY=2
ORG_VERIFY_CONCURRENCY=2
ORG_SCRAPE_CONCURRENCY=2
ORG_SCRAPE_GLOBAL_CONCURRENCY=4
ORG_SCRAPE_PER_HOST_CONCURRENCY=2
# Server-only managed-browser /content-compatible endpoint. Normal HTTP fetch
# always runs first; this is used only for likely JS shells and blocked high-value pages.
BROWSER_RENDER_URL=
BROWSER_RENDER_API_KEY=
ORG_PRIMARY_SEARCH_USES=5
ORG_PROFILE_RESCUE_SEARCH_USES=1
ORG_EMAIL_RESCUE_SEARCH_USES=4
SEARXNG_URL=
# Default is deliberately offline. Set to `live` only after approving a real
# extraction run; automated tests always use stubs.
EXTRACTION_MODE=stub

# Drafting research/writer mode. Default stub never calls Claude or web_search.
# Set DRAFTING_MODE=live only after offline system works and a human authorizes
# a manual Enrich/Draft run in the app (never from automated tests/agents).
DRAFTING_MODE=stub
# Research: 2 total provider calls, including the forced final report.
# The first call handles search choreography; the second produces the packet.
# Set searches to 2 for faster drafts when quality holds.
DRAFT_RESEARCH_MAX_SEARCHES=2
DRAFT_RESEARCH_MAX_CALLS=2
DRAFT_RESEARCH_MAX_TOKENS=8192
DRAFT_ADVERSARIAL_MAX_SEARCHES=1
DRAFT_ADVERSARIAL_MAX_TURNS=4
DRAFT_WRITER_MAX_TOKENS=2000
DRAFTING_PROMPT_CACHE_TTL=1h
DRAFTING_DEFAULT_BATCH_BUDGET_USD=30.0000
ORG_DRAFT_RESEARCH_CONCURRENCY=8
ORG_DRAFT_WRITE_CONCURRENCY=8
# Effective lane limits are capped at floor(DRAFTING_ANTHROPIC_MAX_INFLIGHT / peak_calls).
# Cold-start ramp: stagger Go to Drafting pipeline starts (ms between each lead).
DRAFTING_ANTHROPIC_MAX_INFLIGHT=8
DRAFTING_CAMPAIGN_RAMP_MS=3000

# https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

AGENT_MAIL_API=
AGENTMAIL_TLS_INSECURE=false
AGENTMAIL_INBOX_ID=lafwh@agentmail.to
AGENTMAIL_VERIFY_WAIT_MS=30000
ORG_MAILBOX_VERIFY_CONCURRENCY=3

# ── Outbound email (Resend) ───────────────────────────────────────────────────
# https://resend.com/api-keys — server-only, never expose to the browser
RESEND_API_KEY=
# Optional override when sender profile email is not on a verified Resend domain
# RESEND_FROM_EMAIL=onboarding@yourdomain.com
# Webhook signing secret (Resend → Webhooks → Signing Secret). Required for
# POST /api/webhooks/resend engagement ingestion (delivery/open/click/bounce/reply).
RESEND_WEBHOOK_SECRET=
# Inbound Reply-To domain (plus-address reply+{itemId}@…). Default replies.heliosgroup.ai
# RESEND_REPLY_DOMAIN=replies.heliosgroup.ai
#
# Manual Resend checklist (not automated):
# 1. Domain heliosgroup.ai → enable open tracking (+ click if desired) + tracking CNAME
# 2. Add receiving domain replies.heliosgroup.ai MX records per Resend
# 3. Create webhook → production https://…/api/webhooks/resend with events:
#    email.sent, email.delivered, email.delivery_delayed, email.opened, email.clicked,
#    email.bounced, email.complained, email.failed, email.received
# 4. Put signing secret in RESEND_WEBHOOK_SECRET (.env.local / Vercel)
# 5. Local testing: ngrok/port-forward to /api/webhooks/resend
